# TWRP recovery.fstab for Infinix X6886

# Logical partitions
system          /system         erofs    ro              wait,slotselect,logical,avb=vbmeta_system,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system          /system         ext4     ro              wait,slotselect,logical,avb=vbmeta_system,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext      /system_ext     erofs    ro              wait,slotselect,logical,avb=vbmeta_system,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
system_ext      /system_ext     ext4     ro              wait,slotselect,logical,avb=vbmeta_system,avb_keys=/avb/q-gsi.avbpubkey:/avb/r-gsi.avbpubkey:/avb/s-gsi.avbpubkey
vendor          /vendor         erofs    ro              wait,slotselect,logical,avb
vendor          /vendor         ext4     ro              wait,slotselect,logical,avb
product         /product        erofs    ro              wait,slotselect,logical,avb
product         /product        ext4     ro              wait,slotselect,logical,avb
odm             /odm            erofs    ro              wait,slotselect,logical,avb
odm             /odm            ext4     ro              wait,slotselect,logical,avb
vendor_dlkm     /vendor_dlkm    erofs    ro              wait,slotselect,logical,avb
vendor_dlkm     /vendor_dlkm    ext4     ro              wait,slotselect,logical,avb
odm_dlkm        /odm_dlkm       erofs    ro              wait,slotselect,logical,avb
odm_dlkm        /odm_dlkm       ext4     ro              wait,slotselect,logical,avb
system_dlkm     /system_dlkm    erofs    ro              wait,slotselect,logical,avb
system_dlkm     /system_dlkm    ext4     ro              wait,slotselect,logical,avb

# Transsion logical partitions
tr_region       /tr_region      erofs    ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_region       /tr_region      ext4     ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_company      /tr_company     erofs    ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_company      /tr_company     ext4     ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_carrier      /tr_carrier     erofs    ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_carrier      /tr_carrier     ext4     ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_product      /tr_product     erofs    ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_product      /tr_product     ext4     ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_preload      /tr_preload     erofs    ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_preload      /tr_preload     ext4     ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_overlayfs    /tr_overlayfs   erofs    ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail
tr_overlayfs    /tr_overlayfs   ext4     ro              wait,slotselect,logical,avb_keys=/odm/etc/vconfig/tran_avb.pubkey,nofail

# Data partitions
/dev/block/by-name/metadata    /metadata   f2fs    noatime,nosuid,nodev,discard                       wait,check
/dev/block/by-name/userdata    /data       f2fs    noatime,nosuid,nodev,discard,noflush_merge         wait,check,resize,quota,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

# Boot & firmware partitions
/dev/block/by-name/boot           /boot           emmc    defaults    slotselect
/dev/block/by-name/dtbo           /dtbo           emmc    defaults    slotselect
/dev/block/by-name/misc           /misc           emmc    defaults    defaults
/dev/block/by-name/vendor_boot    /vendor_boot    emmc    defaults    defaults
/dev/block/by-name/init_boot      /init_boot      emmc    defaults    defaults
/dev/block/by-name/vbmeta         /vbmeta         emmc    defaults    defaults
/dev/block/by-name/vbmeta_system  /vbmeta_system  emmc    defaults    slotselect,avb=vbmeta
/dev/block/by-name/vbmeta_vendor  /vbmeta_vendor  emmc    defaults    slotselect
/dev/block/by-name/logo           /logo           emmc    defaults    defaults
/dev/block/by-name/lk             /bootloader     emmc    defaults    defaults
/dev/block/by-name/lk2            /bootloader2    emmc    defaults    defaults

# Vendor-specific partitions
/dev/block/by-name/tranfs         /tranfs         ext4    noatime,nosuid,nodev,noauto_da_alloc,discard  wait,check,nofail
/dev/block/by-name/persist        /mnt/vendor/persist  ext4  noatime,nosuid,nodev,noauto_da_alloc     wait,check
/dev/block/by-name/nvdata         /mnt/vendor/nvdata   ext4  noatime,nosuid,nodev,noauto_da_alloc     wait,check
/dev/block/by-name/protect1       /mnt/vendor/protect_f  ext4  noatime,nosuid,nodev,noauto_da_alloc   wait,check
/dev/block/by-name/protect2       /mnt/vendor/protect_s  ext4  noatime,nosuid,nodev,noauto_da_alloc   wait,check
/dev/block/by-name/nvcfg          /mnt/vendor/nvcfg      ext4  noatime,nosuid,nodev,noauto_da_alloc   wait,check
/dev/block/by-name/tkv            /tkv           emmc    defaults    defaults

# SD card
/devices/platform/11240000.mmc*   /external_sd   auto    defaults    voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb*         /usb_otg       vfat    defaults    voldmanaged=usbotg:auto,encryptable=userdata
